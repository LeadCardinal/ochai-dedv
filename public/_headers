# Cache-control for static assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/cdn-cgi/image/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Catch-all for documents served via clean URLs (e.g. /apps/, /services/) —
# the /*.html rule above only matches literal .html paths, which this site
# never actually requests, so without this, HTML silently fell through to
# Cloudflare Pages' default long-lived cache instead of revalidating.
/*
  Cache-Control: public, max-age=0, must-revalidate
